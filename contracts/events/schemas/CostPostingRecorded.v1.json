{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.slateiq.com/events/expense/CostPostingRecorded.v1.json",
  "title": "CostPostingRecorded",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "aggregateId",
    "orgId",
    "timestamp",
    "correlationId",
    "version",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "expense.cost_posting_recorded.v1" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "orgId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "payload": {
      "type": "object",
      "required": [
        "postingId",
        "expenseId",
        "showId",
        "periodId",
        "departmentId",
        "postingType",
        "baseAmount",
        "currency",
        "effectiveDate"
      ],
      "properties": {
        "postingId": { "type": "string", "format": "uuid" },
        "expenseId": { "type": "string", "format": "uuid" },
        "showId": { "type": "string", "format": "uuid" },
        "periodId": { "type": "string", "format": "uuid" },
        "departmentId": { "type": "string", "format": "uuid" },
        "postingType": { "type": "string", "enum": ["POSTING", "REVERSAL", "SUPERSESSION_REVERSAL"] },
        "baseAmount": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{4}$" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "effectiveDate": { "type": "string", "format": "date" }
      }
    }
  }
}
