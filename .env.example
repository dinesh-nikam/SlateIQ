# ==============================================================================
# SlateIQ Local Development Environment Configuration
# Copy this file to .env before starting services with docker compose
# ==============================================================================

# Project
COMPOSE_PROJECT_NAME=slateiq

# Database (PostgreSQL 17)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slateiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_USER=slateiq_app
APP_DB_PASSWORD=slateiq_app_dev_pw
MIGRATOR_DB_USER=slateiq_migrator
MIGRATOR_DB_PASSWORD=slateiq_migrator_dev_pw

# Cache & Revocation (Redis 7.4)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=slateiq_local_redis_secret

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_CONSOLE_PORT=9001
S3_ROOT_USER=slateiq_admin
S3_ROOT_PASSWORD=slateiq_local_s3_secret
S3_REGION=ap-south-1
S3_BUCKET_EVIDENCE=slq-local-in-evidence
S3_BUCKET_QUARANTINE=slq-local-in-evidence-quarantine
S3_BUCKET_IMPORTS=slq-local-in-imports
S3_BUCKET_AUDIT_ARCHIVE=slq-local-in-audit-archive

# Backend Runtime Settings
ASPNETCORE_ENVIRONMENT=Development
SLATEIQ_HOST__ROLE=api
SLATEIQ_REGION=IN
