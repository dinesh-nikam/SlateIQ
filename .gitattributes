# Set default behaviour to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.cs text diff=csharp eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.tf text eol=lf
*.proto text eol=lf

# Windows-specific script files
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.xlsx binary
*.xls binary
